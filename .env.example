# Contact form — https://resend.com
# Without a key the form answers 503 and says so, rather than pretending to
# have sent the message.
RESEND_API_KEY=

# Where the messages land. Leave empty and they go to the address set in
# app/api/contact/route.ts; this overrides it without touching the code.
CONTACT_TO_EMAIL=

# The From address. Resend only accepts a domain you have verified with them;
# their sandbox address works for testing and needs no setup.
CONTACT_FROM_EMAIL="Pitiusa Art Station <onboarding@resend.dev>"
